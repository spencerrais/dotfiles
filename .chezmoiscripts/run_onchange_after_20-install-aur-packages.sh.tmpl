{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
#!/usr/bin/env bash
set -euo pipefail

aur_packages=(
  1password
  brave-bin
)

if ! command -v paru >/dev/null 2>&1; then
  echo "paru is required but not installed."
  exit 1
fi

# Import the 1Password package signing key if it is not already present.
onepassword_key="AC2D62742012EA22"

if ! gpg --list-keys "$onepassword_key" >/dev/null 2>&1; then
    echo "Importing 1Password signing key..."
    curl -fsSL https://downloads.1password.com/linux/keys/1password.asc |
        gpg --import
fi

paru -S --needed "${aur_packages[@]}"
{{ end -}}
